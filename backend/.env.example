# Server Configuration
PORT=3001
CLIENT_URL=http://localhost:5173

# AI Engine Configuration
# Options for AI_PROVIDER: "gemini" | "ollama"
AI_PROVIDER=gemini
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Local / VPS Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database Persistence Configuration (PostgreSQL)
# If left empty, the server automatically uses the high-performance in-memory mock store
# Compatible with Neon.tech, Supabase, Render Postgres, AWS RDS, Docker, etc.
DATABASE_URL=
DATABASE_SSL=true
